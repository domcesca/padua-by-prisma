# Census Data API key, used only by the ETL (python -m hcai_etl acs-county) to fetch county
# demographics.
# Free key: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# Accounts database (V7.6.5a), optional: without it the app runs as before and sign-in says accounts aren't set up.
# PostgreSQL 15+. Put it in .env.local (git-ignored) for local development. Migrate with: npm run db:migrate
# See docs/accounts-security.md for the recommended production role.
DATABASE_URL=
